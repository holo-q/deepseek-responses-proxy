[Unit]
Description=Responses-to-chat proxy for Codex custom providers
Documentation=https://github.com/holo-q/deepseek-responses-proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=HOME=%h
Environment=PATH=%h/.local/bin:%h/.cargo/bin:%h/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/env uvx --from git+https://github.com/holo-q/deepseek-responses-proxy deepseek-responses-proxy --bind 127.0.0.1 --port 8787 --chat-base-url https://api.deepseek.com --api-key-pass api-keys/deepseek
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
